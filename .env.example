POSTGRES_DB=iyosi
POSTGRES_USER=iyosi
POSTGRES_PASSWORD=local-development-only

# Generate with: openssl rand -hex 32
IYOSI_SECRET=replace-with-a-random-64-character-secret
# Optional GeoJSON feature-search adapter endpoint; see docs/API_RESOURCE_MODEL.md
GEOCODER_URL=
# Preferred hosted address autocomplete for a private pilot; server-side secret.
# When set, this takes precedence over GEOCODER_URL. See docs/GEOCODER.md.
GEOAPIFY_API_KEY=
